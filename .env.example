# Copie para .env e preencha. Nunca commite o .env.
# Em sessões do Claude Code na nuvem, cadastre estas variáveis nas configurações do ambiente.

# Supabase (públicas: vão para o navegador)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legada; o código usa a PUBLISHABLE_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (secretas: somente scripts de migration/seed, nunca no navegador)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Claude API (secreta: somente servidor; usada a partir da geração do plano, etapa 3.3)
ANTHROPIC_API_KEY=

# App
# debug | info | warn | error (padrão: info)
LOG_LEVEL=
